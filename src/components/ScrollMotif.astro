---
interface Props {
  kind: 'intro' | 'music' | 'artists' | 'contact';
}
const { kind } = Astro.props;
---
<svg class={`scroll-motif scroll-motif-${kind}`} data-scroll-art viewBox="0 0 520 380" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  {kind === 'intro' && <g>
    <path data-draw d="M-25 190H100c38 0 51-82 103-82 49 0 58 82 98 82h180" />
    <path data-draw d="M303 190 391 38l88 152-88 152-88-152Z" />
    <path data-draw d="M391 70 459 190l-68 119-68-119 68-120Z" />
    <circle data-draw cx="391" cy="190" r="74" />
    <circle class="motif-dot" cx="391" cy="190" r="5" />
  </g>}
  {kind === 'music' && <g>
    <path data-draw d="M-15 184h62c31 0 36-66 67-66s36 132 67 132 36-132 67-132 36 66 67 66h169" />
    <circle data-draw cx="399" cy="184" r="55" />
    <circle data-draw cx="399" cy="184" r="92" />
    <circle data-draw cx="399" cy="184" r="130" />
    <circle class="motif-dot" cx="399" cy="184" r="5" />
  </g>}
  {kind === 'artists' && <g>
    <path data-draw d="M-20 238h130c38 0 48-110 96-110h75" />
    <path data-draw d="M280 46 458 351H102L280 46Z" />
    <path data-draw d="M280 333 117 65h326L280 333Z" />
    <path data-draw d="M280 101 413 323H147L280 101Z" />
    <circle data-draw cx="280" cy="194" r="51" />
    <circle class="motif-dot" cx="280" cy="194" r="5" />
  </g>}
  {kind === 'contact' && <g>
    <path data-draw d="M-20 190h143c42 0 55-72 102-72h60" />
    <path data-draw d="M285 85c76 50 102 70 102 105s-26 55-102 105M485 85c-76 50-102 70-102 105s26 55 102 105" />
    <path data-draw d="M285 85c70 38 130 38 200 0M285 295c70-38 130-38 200 0M383 101v178" />
    <circle class="motif-dot" cx="383" cy="190" r="6" />
  </g>}
</svg>
