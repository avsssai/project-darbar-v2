---
import Icon from '../components/Icon.astro';
import HeroGroup from '../components/HeroGroup.astro';
import MusicShowcase from '../components/MusicShowcase.astro';
import ArtistCutout from '../components/ArtistCutout.astro';
import BrandMark from '../components/BrandMark.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { brandLineAt, brandLinePartsAt } from '../data/brand';
import { instrumentThreadAt } from '../data/instrument-thread';
import { artists, site } from '../data/site';
import '../styles/global.css';
import { assetPath } from '../lib/asset-path';

const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const motion = matchMedia('(prefers-reduced-motion: reduce)');
        const navigation = performance.getEntriesByType('navigation')[0];
        root.dataset.heroEntrance = 'complete';
        if (motion.matches || location.hash || scrollY > 0 || navigation?.type === 'back_forward' || document.hidden) return;
        root.dataset.heroEntrance = 'pending';
        const listeners = new AbortController();
        let preparation;
        let playback;
        const finish = () => {
          root.dataset.heroEntrance = 'complete';
          clearTimeout(failOpen);
          clearTimeout(preparation);
          clearTimeout(playback);
          listeners.abort();
        };
        // Independent of the bundled page script: hidden content always fails open.
        const failOpen = setTimeout(finish, 1500);
        const options = { signal: listeners.signal };
        addEventListener('scroll', finish, { ...options, passive: true });
        addEventListener('pagehide', finish, options);
        addEventListener('pageshow', (event) => { if (event.persisted) finish(); }, options);
        addEventListener('hashchange', finish, options);
        addEventListener('popstate', finish, options);
        document.addEventListener('visibilitychange', () => { if (document.hidden) finish(); }, options);
        document.addEventListener('focusin', (event) => {
          if (event.target.closest?.('.hero, .site-header, #main')) finish();
        }, options);
        motion.addEventListener('change', () => { if (motion.matches) finish(); }, options);
        document.addEventListener('DOMContentLoaded', async () => {
          if (root.dataset.heroEntrance !== 'pending') return;
          preparation = setTimeout(finish, 500);
          try {
            const photo = document.querySelector('.band-photo');
            const fonts = document.fonts.load('16px Italiana');
            await Promise.all([fonts, photo ? photo.decode() : Promise.resolve()]);
            if (!document.fonts.check('16px Italiana') || (photo && !photo.naturalWidth)) return finish();
            // Commit the pending pose before starting, even with cached assets.
            requestAnimationFrame(() => requestAnimationFrame(() => {
              if (root.dataset.heroEntrance !== 'pending') return;
              if (scrollY > 0 || location.hash || motion.matches || document.hidden) return finish();
              clearTimeout(preparation);
              root.dataset.heroEntrance = 'running';
              playback = setTimeout(finish, 900);
            }));
          } catch { finish(); }
        }, { ...options, once: true });
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f7f5f1" />
    <meta name="description" content={site.description} />
    <meta property="og:title" content={site.name} />
    <meta property="og:description" content={site.description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={assetPath('/favicon.svg')} />
    <link rel="preload" href={assetPath('/fonts/italiana-latin-400.woff2')} as="font" type="font/woff2" crossorigin />
    {site.heroImage && <link rel="preload" href={assetPath(site.heroImage)} as="image" fetchpriority="high" />}
    <title>{site.name} — Carnatic fusion</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header" id="top">
        <a class="wordmark" href="#top" aria-label={site.name + ', back to top'}><BrandMark /></a>
        <nav class="main-nav" aria-label="Main navigation">
          <a href="#music">Music</a><a href="#about">The band</a><a href="#artists">Artists</a>
        </nav>
        <div class="header-actions"><a class="header-book" href="#contact">Bookings <span aria-hidden="true"><Icon name="up-right" /></span></a><SocialLinks placement="header" /></div>
      </header>

      <main id="main" tabindex="-1">
        <svg class="journey-rail" viewBox="0 0 1000 1000" preserveAspectRatio="none" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="rail-ink" x1="0" y1="0" x2="0" y2="1000" gradientUnits="userSpaceOnUse">
              <stop offset="0" stop-color="#1951A8" />
              <stop data-hero-dark-end offset=".1" stop-color="#1951A8" />
              <stop data-hero-light-start offset=".101" stop-color="#1951A8" />
              <stop data-hero-light-end offset=".18" stop-color="#1951A8" />
              <stop data-hero-dark-start offset=".181" stop-color="#1951A8" />
              <stop data-rail-dark-end offset=".8" stop-color="#1951A8" />
              <stop data-rail-light-start offset=".801" stop-color="#1951A8" />
              <stop offset="1" stop-color="#1951A8" />
            </linearGradient>
          </defs>
          <path data-rail-route d="M946 0V60C946 95 735 70 735 115S955 150 955 190V900" stroke="url(#rail-ink)" />
          <path data-rail-chakra d={brandLineAt(955, 900, .13)} visibility="hidden" />
          <g stroke="#1951A8" data-rail-symbol>
            {brandLinePartsAt(955, 900, .13).map((d) => <path data-rail-symbol-part d={d} />)}
          </g>
        </svg>

        <section class="hero" aria-labelledby="hero-heading">
          <div class="hero-field" aria-hidden="true"></div>
          <h1 id="hero-heading" aria-label={site.name}>
            <span class="title-mask"><span class="title-top">THE PROJECT</span></span>
            <span class="title-mask"><span class="title-name">DARB<span class="title-letter-mark"><span class="title-letter-placeholder">A</span><BrandMark class="title-brand-mark" width={335} height={680} /></span>R</span></span>
          </h1>
          <p class="hero-caption">Carnatic roots.<br /> New frequencies.</p>
          <div class:list={['hero-figures', { 'hero-figures--original': site.heroImageStyle === 'original-photo' }]} role={site.heroImage ? undefined : 'img'} aria-label={site.heroImage ? undefined : 'Four band silhouettes, awaiting the ensemble photograph'}>
            <div class="hero-figures-front">
              <div class="hero-entrance">
              {site.heroImage ? <img class="band-photo" src={assetPath(site.heroImage)} alt="The four members of The Project Darbar with their instruments" fetchpriority="high" /> : <HeroGroup />}
              </div>
            </div>
          </div>
          <div class="hero-bottom">
            <p>INDIAN /<br />CARNATIC FUSION</p>
            <a class="quiet-link" href="#music">Hear the sound <span aria-hidden="true"><Icon name="down" /></span></a>
          </div>
        </section>

        <section class="chapter chapter-music" id="music" aria-labelledby="music-heading">
          <MusicShowcase />
        </section>

        <section class="chapter chapter-about" id="about" aria-labelledby="about-heading">
          <div class="chapter-inner">
            <p class="chapter-index" data-reveal><span>02</span> / THE BAND</p>
            <div class="about-layout">
              <div class="about-copy">
                <h2 id="about-heading" data-reveal>OLD ROOTS.<br /><em>NEW FIRE.</em></h2>
                <p class="chapter-prose" data-reveal>The Project Darbar brings Carnatic influence into a contemporary band setting, following melody and rhythm wherever they lead.</p>
              </div>
              <figure class="instrument-figure">
                <div class="instrument-stage" data-instrument-stage role="img" aria-label="One continuous thread forming a keyboard, percussion, violin and bass together">
                  <svg class="instrument-static" viewBox="0 0 600 480" aria-hidden="true"><path d={'M600 0' + instrumentThreadAt(0, 0, 600, 480)} /></svg>
                </div>
                <figcaption>KEYS / PERCUSSION / VIOLIN / BASS</figcaption>
              </figure>
            </div>
          </div>
        </section>

        <section class="chapter chapter-artists" id="artists" aria-labelledby="artists-heading">
          <div class="chapter-inner">
            <p class="chapter-index" data-reveal><span>03</span> / THE PEOPLE</p>
            <h2 id="artists-heading" data-reveal>THE<br /><em>ENSEMBLE.</em></h2>
            <div class="artist-list">
              {artists.map((artist, index) => (
                <article class="artist-row" data-reveal style={'--stagger:' + index * 75 + 'ms'}>
                  <span class="artist-number">0{index + 1}</span>
                  <div class="artist-details">
                    <h3>{artist.name || artist.role}</h3>
                    <p class="artist-instrument">{artist.name ? artist.role : artist.bio}</p>
                    {artist.name && <p class="artist-description">{artist.bio}</p>}
                  </div>
                  {artist.image && artist.cutout ? (
                    <ArtistCutout source={artist.image} viewBox={artist.cutout.viewBox} outline={artist.cutout.outline} label={`${artist.role} player from The Project Darbar`} clipId={`artist-cutout-${index + 1}`} />
                  ) : artist.image && <span class="artist-portrait"><img class="artist-cutout" src={assetPath(artist.image)} alt={artist.name || `${artist.role} player`} loading="lazy" /></span>}
                </article>
              ))}
            </div>
          </div>
        </section>

        <section class="chapter chapter-contact" id="contact" aria-labelledby="contact-heading">
          <div class="chapter-inner">
            <p class="chapter-index" data-reveal><span>04</span> / THE INVITATION</p>
            <h2 id="contact-heading" data-reveal>LET'S<br /><em>PLAY.</em></h2>
            <p class="contact-copy" data-reveal>For stages, festivals, private events, and collaborations, bring The Project Darbar into the room.</p>
            <div class="contact-actions" data-reveal>
              {site.email ? <a class="pill-link pill-light" href={'mailto:' + site.email}>Send a booking enquiry <span aria-hidden="true"><Icon name="up-right" /></span></a> : <span class="pill-link pill-disabled">Booking email coming soon</span>}
              {site.youtube && <a class="quiet-link" href={site.youtube} target="_blank" rel="noopener noreferrer">YouTube <Icon name="up-right" /></a>}
              {site.instagram && <a class="quiet-link" href={site.instagram} target="_blank" rel="noopener noreferrer">Instagram <Icon name="up-right" /></a>}
            </div>
          </div>
        </section>
        <div class="mobile-finale" data-logo-stage aria-hidden="true"><BrandMark class="finale-static" width={104} height={212} /></div>
      </main>
      <footer class="site-footer"><a class="footer-brand" href="#top"><BrandMark width={28} height={52} /><span>THE PROJECT DARBAR</span></a><SocialLinks placement="footer" /><span class="footer-copyright">© {year} THE PROJECT DARBAR</span></footer>
    </div>

    <script>
      import { ensembleThreadAt } from '../data/ensemble-thread';
      import { soundThreadAt } from '../data/sound-thread';
      import { railOffsets, scrollStrokeDistance, strokePartOffsets, type StrokeAnchor } from '../lib/rail-progress';
      import { brandLineAt, brandLinePartsAt } from '../data/brand';
      import { instrumentThreadAt } from '../data/instrument-thread';

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const main = document.querySelector<HTMLElement>('main');
      const rail = document.querySelector<SVGSVGElement>('.journey-rail');
      const route = rail?.querySelector<SVGPathElement>('[data-rail-route]');
      const chakra = rail?.querySelector<SVGPathElement>('[data-rail-chakra]');
      const symbolParts = [...document.querySelectorAll<SVGPathElement>('[data-rail-symbol-part]')];
      const darkEnd = rail?.querySelector<SVGStopElement>('[data-rail-dark-end]');
      const lightStart = rail?.querySelector<SVGStopElement>('[data-rail-light-start]');
      const railInk = rail?.querySelector<SVGLinearGradientElement>('#rail-ink');
      const heroField = document.querySelector<HTMLElement>('.hero-field');
      const sections = ['music', 'about', 'artists', 'contact'].map((id) => document.getElementById(id));
      const hero = document.querySelector<HTMLElement>('.hero');
      const figures = document.querySelector<HTMLElement>('.hero-figures');
      const instrumentStage = document.querySelector<HTMLElement>('[data-instrument-stage]');
      const soundStage = document.querySelector<HTMLElement>('[data-sound-stage]');
      const logoStage = document.querySelector<HTMLElement>('[data-logo-stage]');
      const artistRows = [...document.querySelectorAll<HTMLElement>('.artist-row')];
      let routeLength = 0;
      let chakraLength = 0;
      let symbolLengths: number[] = [];
      let drawAnchors: StrokeAnchor[] = [];
      let ticking = false;
      let observer: IntersectionObserver | undefined;

      function measureRail() {
        if (!main || !rail || !route || !chakra) return;
        const height = main.offsetHeight;
        const mainTop = main.getBoundingClientRect().top + window.scrollY;
        const mainLeft = main.getBoundingClientRect().left;
        const stage = instrumentStage?.getBoundingClientRect();
        let instrumentStartLength = 0;
        let instrumentEndLength = 0;
        const sectionCheckpoints: StrokeAnchor[] = [];
        const ensembleSpans: { start: number; end: number; scrollStart: number; scrollEnd: number }[] = [];
        // Layout bounds exclude the portrait's entrance transform.
        const layoutBox = (element: HTMLElement) => {
          let x = 0;
          let y = 0;
          let current: HTMLElement | null = element;
          while (current && current !== main) {
            x += current.offsetLeft;
            y += current.offsetTop;
            current = current.offsetParent as HTMLElement | null;
          }
          return { x, y, width: element.offsetWidth, height: element.offsetHeight };
        };
        railInk?.setAttribute('y2', String(height));
        // Match the ink to the actual background boundaries at every viewport size.
        const setInkBoundary = (selector: string, y: number) => {
          rail?.querySelector<SVGStopElement>(selector)?.setAttribute('offset', String(Math.max(0, Math.min(1, y / height))));
        };
        if (heroField && hero) {
          const fieldTop = heroField.getBoundingClientRect().top + window.scrollY - mainTop;
          setInkBoundary('[data-hero-dark-end]', fieldTop);
          setInkBoundary('[data-hero-light-start]', fieldTop);
          setInkBoundary('[data-hero-light-end]', hero.offsetHeight);
          setInkBoundary('[data-hero-dark-start]', hero.offsetHeight);
        }
        const midpoints = sections.map((section) => section ? section.getBoundingClientRect().top + window.scrollY - mainTop + section.offsetHeight * 0.45 : 0);
        const width = main.clientWidth;
        const x = width - (width <= 520 ? 30 : width <= 760 ? 42 : width <= 1050 ? 62 : 81);
        const heroHeight = hero?.offsetHeight ?? 600;
        const shoulderX = width * 0.77;
        const loopY = heroHeight * 0.62;
        // One continuous path leaves the header, loops behind the band, and enters the chapter rail.
        let d = `M${width * 0.946} 0 V${heroHeight * 0.29} C${width * 0.946} ${loopY - 80} ${shoulderX - 85} ${loopY - 110} ${shoulderX - 85} ${loopY} C${shoulderX - 85} ${loopY + 100} ${x} ${loopY + 100} ${x} ${heroHeight * 0.9}`;
        for (const [index, y] of midpoints.entries()) {
          if (index === 0 && soundStage) {
            const sound = soundStage.getBoundingClientRect();
            const left = sound.left - mainLeft;
            const top = sound.top + window.scrollY - mainTop;
            const center = left + sound.width / 2;
            // The resting waveform belongs to the scroll thread. Playback uses an
            // overlay with the same endpoints, leaving the drawing geometry fixed.
            d += ` L${center} ${top}` + soundThreadAt(left, top, sound.width, sound.height);
            d += ` L${x} ${top + sound.height + 24}`;
            continue;
          }
          if (index === 1 && stage) {
            const stageX = stage.left - mainLeft;
            const stageY = stage.top + window.scrollY - mainTop;
            const entryX = stageX + stage.width;
            d += ` L${x} ${stageY - 40} C${x} ${stageY - 12} ${entryX + 20} ${stageY} ${entryX} ${stageY}`;
            route.setAttribute('d', d);
            instrumentStartLength = route.getTotalLength();
            d += instrumentThreadAt(stageX, stageY, stage.width, stage.height);
            route.setAttribute('d', d);
            instrumentEndLength = route.getTotalLength();
            d += ` C${entryX + 20} ${stageY + stage.height} ${x} ${stageY + stage.height + 12} ${x} ${stageY + stage.height + 40}`;
            continue;
          }
          if (index === 3 && sections[3]) {
            const contactY = sections[3].getBoundingClientRect().top + window.scrollY - mainTop;
            d += ` L${x} ${contactY}`;
            route.setAttribute('d', d);
            sectionCheckpoints.push({ scroll: mainTop + contactY - window.innerHeight * .72, length: route.getTotalLength() });
          }
          if (index === 2 && artistRows.length) {
            for (const row of artistRows) {
              const portrait = row.querySelector<HTMLElement>('.artist-portrait');
              if (!portrait) continue;
              const bounds = layoutBox(row);
              const cutout = layoutBox(portrait);
              const rowBottom = bounds.y + bounds.height;
              d += ` L${x} ${bounds.y}`;
              route.setAttribute('d', d);
              const start = route.getTotalLength();
              d += ensembleThreadAt(x, cutout, bounds.y, rowBottom);
              route.setAttribute('d', d);
              const end = route.getTotalLength();
              const scrollStart = mainTop + bounds.y - window.innerHeight * .62;
              const scrollEnd = mainTop + rowBottom - window.innerHeight * .62;
              sectionCheckpoints.push({ scroll: scrollStart, length: start }, { scroll: scrollEnd, length: end });
              ensembleSpans.push({ start, end, scrollStart, scrollEnd });
            }
            continue;
          }
          d += ` L${x} ${y - 105} C${x} ${y - 45} ${x - 61} ${y - 44} ${x - 61} ${y}`;
          d += ` C${x - 61} ${y + 44} ${x} ${y + 45} ${x} ${y + 105}`;
        }
        const mobileLogo = width <= 760 && logoStage ? logoStage.getBoundingClientRect() : undefined;
        const logoScale = mobileLogo ? .32 : .2;
        const logoX = mobileLogo ? width / 2 + 26 : x;
        const logoJoinY = mobileLogo ? mobileLogo.top + window.scrollY - mainTop + 54 : height - 170;
        d += mobileLogo
          ? ` L${x} ${logoJoinY - 40} C${x} ${logoJoinY - 12} ${logoX + 28} ${logoJoinY - 24} ${logoX} ${logoJoinY}`
          : ` L${x} ${logoJoinY}`;
        route.setAttribute('d', d);
        // Join the thread to the upper terminal of the supplied logo.
        chakra.setAttribute('d', brandLineAt(logoX, logoJoinY, logoScale));
        const symbolPaths = brandLinePartsAt(logoX, logoJoinY, logoScale);
        symbolParts.forEach((part, index) => part.setAttribute('d', symbolPaths[index]));
        const contact = sections[3];
        if (contact && darkEnd && lightStart) {
          const contactTop = contact.getBoundingClientRect().top + window.scrollY - mainTop;
          const split = Math.max(0, Math.min(1, contactTop / height));
          darkEnd.setAttribute('offset', String(split));
          lightStart.setAttribute('offset', String(split));
        }
        rail.setAttribute('viewBox', `0 0 ${width} ${height}`);
        routeLength = route.getTotalLength();
        symbolLengths = symbolParts.map((part) => part.getTotalLength());
        chakraLength = symbolLengths.reduce((total, length) => total + length, 0);
        const maxScroll = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
        const startScroll = mainTop - window.innerHeight * .72;
        drawAnchors = [{ scroll: startScroll, length: 0 }];
        if (stage && instrumentEndLength > instrumentStartLength) {
          const stageTop = stage.top + window.scrollY;
          const end = Math.min(maxScroll - 1, stageTop + stage.height - window.innerHeight * .3);
          const start = Math.max(startScroll + 1, Math.min(end - 1, stageTop - window.innerHeight * .8));
          drawAnchors.push({ scroll: start, length: instrumentStartLength }, { scroll: end, length: instrumentEndLength });
        }
        const instrumentScrollStart = drawAnchors[1]?.scroll ?? startScroll;
        const instrumentScrollEnd = drawAnchors[2]?.scroll ?? maxScroll;
        for (const checkpoint of sectionCheckpoints) {
          // Skip unavailable spans instead of squeezing a section into one scroll pixel.
          if (checkpoint.scroll > drawAnchors[drawAnchors.length - 1].scroll && checkpoint.scroll < maxScroll) drawAnchors.push(checkpoint);
        }
        drawAnchors.push({ scroll: maxScroll, length: routeLength + chakraLength });
        document.documentElement.classList.add('rail-ready');
        rail.dataset.instrumentStart = String(instrumentStartLength);
        rail.dataset.instrumentEnd = String(instrumentEndLength);
        rail.dataset.instrumentScrollStart = String(instrumentScrollStart);
        rail.dataset.instrumentScrollEnd = String(instrumentScrollEnd);
        rail.dataset.drawAnchors = JSON.stringify(drawAnchors);
        rail.dataset.ensembleSpans = JSON.stringify(ensembleSpans);
        route.style.strokeDasharray = String(routeLength);
        chakra.style.strokeDasharray = String(chakraLength);
        symbolParts.forEach((part, index) => { part.style.strokeDasharray = String(symbolLengths[index]); });
        if (reduceMotion.matches) {
          route.style.strokeDashoffset = '0';
          chakra.style.strokeDashoffset = '0';
          symbolParts.forEach((part) => { part.style.strokeDashoffset = '0'; });
        } else update();
      }

      function update() {
        if (!main || !route || !chakra || !hero || !figures || reduceMotion.matches) { ticking = false; return; }
        const drawn = scrollStrokeDistance(window.scrollY, drawAnchors);
        const offsets = railOffsets(drawn / Math.max(1, routeLength + chakraLength), routeLength, chakraLength);
        route.style.strokeDashoffset = String(offsets.route);
        chakra.style.strokeDashoffset = String(offsets.chakra);
        const symbolOffsets = strokePartOffsets(chakraLength - offsets.chakra, symbolLengths);
        symbolParts.forEach((part, index) => { part.style.strokeDashoffset = String(symbolOffsets[index]); });
        const heroProgress = Math.max(0, Math.min(1, -hero.getBoundingClientRect().top / Math.max(1, hero.offsetHeight)));
        const travel = window.innerWidth <= 760 ? 0.45 : 1;
        hero.style.setProperty('--title-shift', heroProgress * -20 * travel + 'px');
        figures.style.setProperty('--front-shift', heroProgress * -60 * travel + 'px');

        ticking = false;
      }
      const schedule = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };

      if (!reduceMotion.matches) {
        document.documentElement.classList.add('motion-ready');
        const revealObserver = new IntersectionObserver((entries) => {
          for (const entry of entries) if (entry.isIntersecting) { entry.target.classList.add('is-visible'); revealObserver.unobserve(entry.target); }
        }, { threshold: 0.12, rootMargin: '0px 0px -5% 0px' });
        observer = revealObserver;
        document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((element) => revealObserver.observe(element));
        window.addEventListener('scroll', schedule, { passive: true });
      }
      measureRail();
      window.addEventListener('resize', measureRail);
      window.addEventListener('load', measureRail, { once: true });
      document.fonts.ready.then(measureRail);
      if (main) new ResizeObserver(measureRail).observe(main);
      reduceMotion.addEventListener('change', () => {
        if (reduceMotion.matches) {
          document.documentElement.classList.remove('motion-ready');
          observer?.disconnect();
          window.removeEventListener('scroll', schedule);
          hero?.style.removeProperty('--title-shift');
          figures?.style.removeProperty('--front-shift');
          measureRail();
        } else {
          document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((element) => element.classList.add('is-visible'));
          document.documentElement.classList.add('motion-ready');
          measureRail();
          window.addEventListener('scroll', schedule, { passive: true });
        }
      });

    </script>
  </body>
</html>
