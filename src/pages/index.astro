---
import ChakraArt from '../components/ChakraArt.astro';
import Damaru from '../components/Damaru.astro';
import { artists, music, site } from '../data/site';
import '../styles/global.css';

const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#101f2a" />
    <meta name="description" content={site.description} />
    <meta property="og:title" content={site.name} />
    <meta property="og:description" content={site.description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{site.name} — Carnatic fusion</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header" id="top">
        <a class="brand" href="#top" aria-label={`${site.name}, back to top`}>
          <span class="brand-symbol" aria-hidden="true"><span></span></span>
          <span class="brand-type"><strong>PROJECT</strong><em>DARBAR</em></span>
        </a>
        <nav class="main-nav" aria-label="Main navigation">
          <a href="#about">About</a>
          <a href="#music">Music</a>
          <a href="#artists">Artists</a>
          <a href="#contact">Contact</a>
        </nav>
        <a class="header-cta" href="#music">Explore the sound <span aria-hidden="true">↗</span></a>
      </header>

      <main id="main">
        <section class="hero" aria-labelledby="hero-heading">
          <div class="hero-grain" aria-hidden="true"></div>
          <div class="hero-content">
            <p class="eyebrow"><span class="eyebrow-line"></span> An Indian Carnatic fusion band</p>
            <h1 id="hero-heading">Ancient pulse.<br /><i>New resonance.</i></h1>
            <p class="hero-copy">A space where Carnatic roots meet contemporary expression. Enter the sound of <strong>The Project Darbar.</strong></p>
            <div class="hero-actions">
              <a class="button button-light" href="#music">Discover the music <span aria-hidden="true">↗</span></a>
              <a class="text-link" href="#about">Our story <span aria-hidden="true">↓</span></a>
            </div>
            <div class="hero-footer"><span>Rhythm / Raga / Reimagined</span><span>Scroll to explore <span aria-hidden="true">↓</span></span></div>
          </div>
          <div class="hero-art" aria-hidden="true">
            <div class="art-orbit art-orbit-one"></div>
            <div class="art-orbit art-orbit-two"></div>
            <ChakraArt class="chakra-hero" />
            <span class="art-caption art-caption-top">THE SPACE BETWEEN<br />TRADITION & TOMORROW</span>
            <span class="art-caption art-caption-bottom">ॐ&nbsp; / &nbsp;NĀDA</span>
          </div>
        </section>

        <div class="marquee" aria-hidden="true"><span>RAGA</span><span class="marquee-star">✳</span><span>RHYTHM</span><span class="marquee-star">✳</span><span>RESONANCE</span><span class="marquee-star">✳</span><span>RAGA</span><span class="marquee-star">✳</span><span>RHYTHM</span></div>

        <section class="about section-pad" id="about" aria-labelledby="about-heading">
          <div class="section-heading">
            <p class="section-kicker"><span>01 / The spirit</span><span class="small-rule"></span></p>
            <h2 id="about-heading">A dialogue across <em>time & sound.</em></h2>
          </div>
          <div class="about-body">
            <div class="about-mark" aria-hidden="true"><Damaru /><span>Sound begins<br />with a beat.</span></div>
            <div class="about-text">
              <p class="large-copy">Rooted in the depth of Carnatic music, The Project Darbar imagines what happens when inherited melodies meet fresh textures and an open mind.</p>
              <p>Inspired by the layered geometry of the Sri Chakra and the energy of Shiva’s damaru, the visual world reflects a musical idea: many paths, one pulse.</p>
              <a class="inline-link" href="#artists">Meet the artists <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </section>

        <section class="music section-pad" id="music" aria-labelledby="music-heading">
          <div class="section-topline"><p class="section-kicker">02 / Listen in</p><Damaru class="section-icon" /></div>
          <div class="music-heading-row"><h2 id="music-heading">The sound, <em>in motion.</em></h2><p>Performances, sessions, and sonic explorations live here. Add a YouTube video ID in the content file to make a preview playable.</p></div>
          <div class="music-grid">
            {music.map((entry, index) => (
              <article class="music-card">
                <div class={`music-art music-art-${index + 1}`}>
                  <span class="music-art-ring" aria-hidden="true"></span>
                  <span class="music-number">0{index + 1} / SHOWCASE</span>
                  {entry.youtubeId ? (
                    <button class="play-button" type="button" data-youtube-id={entry.youtubeId} aria-label={`Play ${entry.title} on YouTube`}><span aria-hidden="true">▶</span></button>
                  ) : (
                    <span class="preview-pending">VIDEO PREVIEW<br />COMING SOON</span>
                  )}
                </div>
                <div class="music-card-copy"><div><span class="card-kicker">{entry.subtitle}</span><h3>{entry.title}</h3><p>{entry.note}</p></div><span class="card-arrow" aria-hidden="true">↗</span></div>
              </article>
            ))}
          </div>
          <p class="content-note">The performances above are sample entries. Replace them with confirmed releases and YouTube IDs in <code>src/data/site.ts</code>.</p>
        </section>

        <section class="artists section-pad" id="artists" aria-labelledby="artists-heading">
          <div class="artists-intro"><div><p class="section-kicker">03 / The ensemble</p><h2 id="artists-heading">The people behind <em>the pulse.</em></h2></div><p>Every voice adds a new dimension. Meet the artists shaping the sound of The Project Darbar.</p></div>
          <div class="artist-grid">
            {artists.map((artist, index) => (
              <article class="artist-card">
                <div class={`artist-portrait artist-portrait-${index + 1}`}>
                  {artist.image ? <img src={artist.image} alt={`Portrait of ${artist.name}`} loading="lazy" /> : <span class="portrait-glyph" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>}
                  <span class="portrait-label">ARTIST PROFILE</span>
                </div>
                <div class="artist-meta"><span>{artist.role}</span><span>0{index + 1}</span></div>
                <h3>{artist.name}</h3><p>{artist.bio}</p>
              </article>
            ))}
          </div>
          <p class="content-note">Artist names, roles, biographies, and portraits are editable sample content.</p>
        </section>

        <section class="contact section-pad" id="contact" aria-labelledby="contact-heading">
          <ChakraArt class="contact-chakra" />
          <div class="contact-content"><p class="section-kicker">04 / Begin a conversation</p><h2 id="contact-heading">Let’s make<br /><em>something resonate.</em></h2><p>For performances, collaborations, and conversations, reach out when the band’s contact details are ready.</p>
            <div class="contact-actions">
              {site.email ? <a class="button button-light" href={`mailto:${site.email}`}>Get in touch <span aria-hidden="true">↗</span></a> : <span class="button button-muted">Email coming soon</span>}
              {site.youtube && <a class="social-link" href={site.youtube} target="_blank" rel="noopener noreferrer">YouTube ↗</a>}
              {site.instagram && <a class="social-link" href={site.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a>}
            </div>
          </div>
        </section>
      </main>
      <footer class="site-footer"><a class="footer-brand" href="#top">THE PROJECT <em>DARBAR</em></a><p>Rooted in rhythm. Open to possibility.</p><span>© {year} The Project Darbar</span></footer>
    </div>
    <script>
      document.querySelectorAll<HTMLButtonElement>('[data-youtube-id]').forEach((button) => {
        button.addEventListener('click', () => {
          const id = button.dataset.youtubeId;
          const art = button.closest('.music-art');
          if (!id || !art || !/^[a-zA-Z0-9_-]{11}$/.test(id)) return;
          const frame = document.createElement('iframe');
          frame.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
          frame.title = button.getAttribute('aria-label') ?? 'YouTube video';
          frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
          frame.allowFullscreen = true;
          frame.className = 'video-frame';
          art.replaceChildren(frame);
        });
      });
    </script>
  </body>
</html>
