---
import ChakraArt from '../components/ChakraArt.astro';
import Damaru from '../components/Damaru.astro';
import ScrollMotif from '../components/ScrollMotif.astro';
import { artists, music, site } from '../data/site';
import '../styles/global.css';

const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#fbf9f5" />
    <meta name="description" content={site.description} />
    <meta property="og:title" content={site.name} />
    <meta property="og:description" content={site.description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{site.name} — Carnatic fusion</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header" id="top">
        <a class="brand" href="#top" aria-label={site.name + ', back to top'}>
          <span class="brand-symbol" aria-hidden="true"><span></span></span>
          <span class="brand-name">THE PROJECT <strong>DARBAR</strong></span>
        </a>
        <nav class="main-nav" aria-label="Main navigation">
          <a href="#about">The band</a><a href="#music">Music</a><a href="#artists">Artists</a>
        </nav>
        <a class="header-cta" href="#contact">Book the band <span aria-hidden="true">↗</span></a>
      </header>

      <main id="main">
        <section class="hero" aria-labelledby="hero-heading">
          <div class="hero-copy">
            <p class="eyebrow"><span class="eyebrow-line"></span> Indian Carnatic fusion</p>
            <h1 id="hero-heading"><span>The Project</span><br /><em>Darbar.</em></h1>
            <p class="hero-statement">Carnatic roots.<br /><span>A sound of our own.</span></p>
            <p class="hero-description">A live experience shaped by classical depth, contemporary energy, and the joy of making music together.</p>
            <div class="hero-actions">
              <a class="button button-primary" href="#contact">Book the band <span aria-hidden="true">↗</span></a>
              <a class="under-link" href="#music">Explore the music <span aria-hidden="true">↓</span></a>
            </div>
          </div>
          <div class="hero-visual">
            <figure class="group-photo">
              {site.heroImage ? <img src={site.heroImage} alt="The Project Darbar band members" /> : <div class="photo-placeholder" role="img" aria-label="Placeholder for a group photograph of The Project Darbar">
                <div class="photo-light" aria-hidden="true"></div>
                <div class="photo-figures" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
                <span class="photo-caption">BAND PHOTOGRAPH<br /><small>IMAGE TO BE ADDED</small></span>
              </div>}
            </figure>
            <div class="hero-seal" aria-hidden="true"><ChakraArt /></div>
            <span class="hero-side-note">TRADITION IN MOTION &nbsp; / &nbsp; 01</span>
          </div>
        </section>

        <div class="rhythm-strip" aria-hidden="true"><span>RAGA</span><span>✳</span><span>RHYTHM</span><span>✳</span><span>RESONANCE</span></div>

        <section class="about section-pad" id="about" aria-labelledby="about-heading">
          <ScrollMotif kind="intro" />
          <div class="section-content about-layout">
            <div><p class="section-kicker">01 / The band</p><h2 id="about-heading">A meeting of <em>tradition and now.</em></h2></div>
            <div class="about-prose"><p>The Project Darbar brings Carnatic influence into a contemporary band setting. The music follows melody, rhythm, and the unexpected spaces between them.</p><p>The visual language follows the same idea: a line finds another line, and a rhythm becomes a form.</p><a class="under-link" href="#artists">Meet the ensemble <span aria-hidden="true">↗</span></a></div>
          </div>
        </section>

        <section class="music section-pad" id="music" aria-labelledby="music-heading">
          <ScrollMotif kind="music" />
          <div class="section-content">
            <div class="section-heading-row"><div><p class="section-kicker">02 / Hear the sound</p><h2 id="music-heading">Music to <em>move with.</em></h2></div><p>A place for performances and sessions. The first confirmed video previews will appear here.</p></div>
            <div class="music-grid">
              {music.map((entry, index) => (
                <article class="music-card">
                  <div class={'music-art music-art-' + (index + 1)}>
                    <span class="music-art-lines" aria-hidden="true"></span>
                    <span class="music-index">0{index + 1} / PERFORMANCE</span>
                    {entry.youtubeId ? <button class="play-button" type="button" data-youtube-id={entry.youtubeId} aria-label={'Play ' + entry.title + ' on YouTube'}><span aria-hidden="true">▶</span></button> : <span class="preview-pending">YOUTUBE PREVIEW<br /><small>COMING SOON</small></span>}
                  </div>
                  <div class="music-meta"><span>{entry.subtitle}</span><span>0{index + 1}</span></div>
                  <h3>{entry.title}</h3>
                </article>
              ))}
            </div>
            <p class="sample-note">Sample preview layout. Official performances will appear here.</p>
          </div>
        </section>

        <section class="artists section-pad" id="artists" aria-labelledby="artists-heading">
          <ScrollMotif kind="artists" />
          <div class="section-content">
            <div class="section-heading-row"><div><p class="section-kicker">03 / Meet the artists</p><h2 id="artists-heading">The people behind <em>the pulse.</em></h2></div><p>Each voice adds a new dimension to the music. The lineup below is ready for the band’s confirmed profiles.</p></div>
            <div class="artist-grid">
              {artists.map((artist, index) => (
                <article class="artist-card">
                  <div class={'artist-portrait artist-portrait-' + (index + 1)}>
                    {artist.image ? <img src={artist.image} alt={'Portrait of ' + artist.name} loading="lazy" /> : <span class="portrait-glyph" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>}
                    {!artist.image && <span class="portrait-label">PHOTO TO BE ADDED</span>}
                  </div>
                  <div class="artist-meta"><span>{artist.role}</span><span>0{index + 1}</span></div>
                  <h3>{artist.name}</h3><p>{artist.bio}</p>
                </article>
              ))}
            </div>
            <p class="sample-note">Sample profiles shown. The confirmed artist lineup will appear here.</p>
          </div>
        </section>

        <section class="contact section-pad" id="contact" aria-labelledby="contact-heading">
          <ScrollMotif kind="contact" />
          <div class="section-content contact-layout">
            <div><p class="section-kicker">04 / Bring the music to you</p><h2 id="contact-heading">Let’s make<br /><em>something resonate.</em></h2><p>For concerts, festivals, private events, and collaborations, connect with The Project Darbar.</p>
              <div class="contact-actions">
                {site.email ? <a class="button button-primary" href={'mailto:' + site.email}>Send a booking enquiry <span aria-hidden="true">↗</span></a> : <span class="button button-unavailable">Booking email coming soon</span>}
                {site.youtube && <a class="under-link" href={site.youtube} target="_blank" rel="noopener noreferrer">YouTube ↗</a>}
                {site.instagram && <a class="under-link" href={site.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a>}
              </div>
            </div>
            <Damaru class="contact-damaru" />
          </div>
        </section>
      </main>
      <footer class="site-footer"><a href="#top">THE PROJECT <strong>DARBAR</strong></a><span>Carnatic roots. New frequencies.</span><span>© {year} The Project Darbar</span></footer>
    </div>
    <script>
      document.querySelectorAll<HTMLButtonElement>('[data-youtube-id]').forEach((button) => {
        button.addEventListener('click', () => {
          const id = button.dataset.youtubeId;
          const art = button.closest('.music-art');
          if (!id || !art || !/^[a-zA-Z0-9_-]{11}$/.test(id)) return;
          const frame = document.createElement('iframe');
          frame.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1';
          frame.title = button.getAttribute('aria-label') ?? 'YouTube video';
          frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
          frame.allowFullscreen = true;
          frame.className = 'video-frame';
          art.replaceChildren(frame);
        });
      });

      const motifs = [...document.querySelectorAll<SVGSVGElement>('[data-scroll-art]')];
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (!reduceMotion.matches && motifs.length) {
        const paths = motifs.map((svg) => {
          let offset = 0;
          const parts = [...svg.querySelectorAll<SVGGeometryElement>('[data-draw]')].map((part) => {
            const length = part.getTotalLength();
            part.style.strokeDasharray = String(length);
            part.style.strokeDashoffset = String(length);
            const start = offset;
            offset += length;
            return { part, length, start };
          });
          return { svg, parts, total: offset };
        });
        let scheduled = false;
        const update = () => {
          const height = window.innerHeight;
          for (const { svg, parts, total } of paths) {
            const rect = svg.closest('section')?.getBoundingClientRect();
            if (!rect) continue;
            const progress = Math.max(0, Math.min(1, (height * 0.82 - rect.top) / (rect.height + height * 0.34)));
            for (const { part, length, start } of parts) {
              const drawn = Math.max(0, Math.min(1, (progress * total - start) / length));
              part.style.strokeDashoffset = String(length * (1 - drawn));
            }
          }
          scheduled = false;
        };
        const schedule = () => { if (!scheduled) { scheduled = true; requestAnimationFrame(update); } };
        window.addEventListener('scroll', schedule, { passive: true });
        window.addEventListener('resize', schedule);
        reduceMotion.addEventListener('change', () => {
          if (reduceMotion.matches) {
            window.removeEventListener('scroll', schedule);
            window.removeEventListener('resize', schedule);
            for (const { parts } of paths) for (const { part } of parts) part.style.strokeDashoffset = '0';
          } else {
            window.addEventListener('scroll', schedule, { passive: true });
            window.addEventListener('resize', schedule);
            schedule();
          }
        });
        schedule();
      }
    </script>
  </body>
</html>
